// ============================================================
// 实验：数码管循环显示 1~9（每 2 秒 +1，按停止按钮熄灭）
// 机型：S7-200 / S7-200 SMART    编程软件：STEP 7-Micro/WIN
// 输入：I0.0 起动（常开）   I0.1 停止（常开，若现场为常闭见文件末尾）
// 输出接线：A=Q0.6  B=Q0.0  C=Q0.1  D=Q0.2  E=Q0.3  F=Q0.5  G=Q0.4
//           H(Q0.7) 全程不写，小数点不显示
// 定时器：T37~T45 为 100ms 分辨率，PT=20 → 每步 2 秒，9 步共 18 秒一循环
// ============================================================

NETWORK 1
// 起保停：M0.0 做运行标志（不占用 Q0.7，避免 H 点常亮）
LD     I0.0
O      M0.0
AN     I0.1
=      M0.0

NETWORK 2
// 第 1 级定时 2s；T45 到时断开会复位本级，实现自动循环
LD     M0.0
AN     T45
TON    T37, 20

NETWORK 3
LD     T37
TON    T38, 20

NETWORK 4
LD     T38
TON    T39, 20

NETWORK 5
LD     T39
TON    T40, 20

NETWORK 6
LD     T40
TON    T41, 20

NETWORK 7
LD     T41
TON    T42, 20

NETWORK 8
LD     T42
TON    T43, 20

NETWORK 9
LD     T43
TON    T44, 20

NETWORK 10
LD     T44
TON    T45, 20

NETWORK 11
// 9 个步标志，每位只写一次；任意时刻只有一个为 1
LD     M0.0
AN     T37
=      M1.0          // 步1：数字 1
LD     T37
AN     T38
=      M1.1          // 步2：数字 2
LD     T38
AN     T39
=      M1.2          // 步3：数字 3
LD     T39
AN     T40
=      M1.3          // 步4：数字 4
LD     T40
AN     T41
=      M1.4          // 步5：数字 5
LD     T41
AN     T42
=      M1.5          // 步6：数字 6
LD     T42
AN     T43
=      M1.6          // 步7：数字 7
LD     T43
AN     T44
=      M1.7          // 步8：数字 8
LD     T44
AN     T45
=      M2.0          // 步9：数字 9

NETWORK 12
// A 段 = Q0.6 ：数字 2 3 5 6 7 8 9
LD     M1.1
O      M1.2
O      M1.4
O      M1.5
O      M1.6
O      M1.7
O      M2.0
=      Q0.6

NETWORK 13
// B 段 = Q0.0 ：数字 1 2 3 4 7 8 9
LD     M1.0
O      M1.1
O      M1.2
O      M1.3
O      M1.6
O      M1.7
O      M2.0
=      Q0.0

NETWORK 14
// C 段 = Q0.1 ：九个数字全亮，直接跟运行标志
LD     M0.0
=      Q0.1

NETWORK 15
// D 段 = Q0.2 ：数字 2 3 5 6 8 9
LD     M1.1
O      M1.2
O      M1.4
O      M1.5
O      M1.7
O      M2.0
=      Q0.2

NETWORK 16
// E 段 = Q0.3 ：数字 2 6 8
LD     M1.1
O      M1.5
O      M1.7
=      Q0.3

NETWORK 17
// F 段 = Q0.5 ：数字 4 5 6 8 9
LD     M1.3
O      M1.4
O      M1.5
O      M1.7
O      M2.0
=      Q0.5

NETWORK 18
// G 段 = Q0.4 ：数字 2 3 4 5 6 8 9
LD     M1.1
O      M1.2
O      M1.3
O      M1.4
O      M1.5
O      M1.7
O      M2.0
=      Q0.4

NETWORK 19
END


// ============================================================
// 附：段码核对表（每个数字应亮的段 / Q 点）
// 1  B C          Q0.0 Q0.1
// 2  A B G E D    Q0.6 Q0.0 Q0.4 Q0.3 Q0.2
// 3  A B G C D    Q0.6 Q0.0 Q0.4 Q0.1 Q0.2
// 4  F G B C      Q0.5 Q0.4 Q0.0 Q0.1
// 5  A F G C D    Q0.6 Q0.5 Q0.4 Q0.1 Q0.2
// 6  A F G E C D  Q0.6 Q0.5 Q0.4 Q0.3 Q0.1 Q0.2
// 7  A B C        Q0.6 Q0.0 Q0.1
// 8  A B C D E F G  七段全亮
// 9  A B C D F G  Q0.6 Q0.0 Q0.1 Q0.2 Q0.5 Q0.4
//
// 附：若停止按钮现场接的是常闭(NC)，把 NETWORK 1 中的
//     AN     I0.1    改为    A      I0.1
//
// 附：若顺接（A=Q0.0 B=Q0.1 C=Q0.2 D=Q0.3 E=Q0.4 F=Q0.5 G=Q0.6），
//     则改装出点即可，步序不用动：
//     NET12 Q0.6→Q0.0  NET13 Q0.0→Q0.1  NET14 Q0.1→Q0.2
//     NET15 Q0.2→Q0.3  NET16 Q0.3→Q0.4  NET17 Q0.5 不变
//     NET18 Q0.4→Q0.6
// ============================================================
